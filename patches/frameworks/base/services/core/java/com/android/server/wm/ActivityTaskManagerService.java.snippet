        @Override
        public Bundle registerExecutionDisplaySession(String sessionId, int executionDisplayId,
                int registrantUid) {
            synchronized (mGlobalLock) {
                return mExecutionDisplayPolicyController.registerExecutionDisplaySession(
                        sessionId, executionDisplayId, registrantUid);
            }
        }

        @Override
        public Bundle updateExecutionDisplaySessionState(String sessionId, int executionDisplayId,
                String state, String reason) {
            synchronized (mGlobalLock) {
                return mExecutionDisplayPolicyController.updateExecutionDisplaySessionState(
                        sessionId, executionDisplayId, state, reason);
            }
        }

        @Override
        public Bundle clearExecutionDisplaySession(String sessionId, String reason) {
            synchronized (mGlobalLock) {
                return mExecutionDisplayPolicyController.clearExecutionDisplaySession(
                        sessionId, reason);
            }
        }

        @Override
        public Bundle startExecutionDisplayStartupTarget(String sessionId, int executionDisplayId,
                String startupMode, String componentName, String reason) {
            return mExecutionDisplayPolicyController.startExecutionDisplayStartupTarget(
                    sessionId, executionDisplayId, startupMode, componentName, reason);
        }

