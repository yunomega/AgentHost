<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/overlay_need_user_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#1E2B33"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_need_user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#394750"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/overlay_need_user_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/overlay_need_user_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:textAllCaps="false" />
    </LinearLayout>
</merge>
